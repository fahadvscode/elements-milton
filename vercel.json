{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.elements-milton.ca" }],
      "destination": "https://elements-milton.ca/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap.xml/", "destination": "/api/sitemap" },
    { "source": "/sitemaps/urlset.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    {
      "source": "/sitemap.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
